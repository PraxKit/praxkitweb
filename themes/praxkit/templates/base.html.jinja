<!DOCTYPE html>
<html lang="de-CH">

<head>
  {# Head carried over from src/_includes/head.html. Dropped: the hardcoded
     Google Analytics snippet (UA property retired), the IE8 html5shiv
     conditional and the humans.txt link. Added: the canonical tag (invisible;
     it is what sitemap.xml advertises). #}
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <title>{% block title %}{% if page.title %}{{ page.title }} &#8211; {% endif %}{{ site.name }} &#8211; Mehr Zeit für dich | Die Praxis Administration mit Terminen und Rechnungen nach Tarif 590{% endblock %}</title>
  <meta name="author" content="Andreas Kapp">
  <meta name="description" content="{% if page.lead %}{{ page.lead }}{% else %}ERP Praxis Software Tarif 590 Termine Rechnungen Therapeuten Therapie Psychologen Kinesiologen{% endif %}">
  <meta name="google-site-verification" content="q5700RT0Cqjz3b9SlV27A9H0sZ--SKSus4-A7J4XIXA" />

  {% if not error %}
  <link rel="canonical" href="{{ absolute_url(page.canonical_url) }}">
  {% endif %}

  <!-- Styles: Bootstrap 5 (no jQuery), Font Awesome 6, then the praxkit
       layer compiled from css/praxkit.scss (the ported 2017 design). -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  {% for css in theme.assets.css %}
  <link rel="stylesheet" type="text/css" href="/{{ ('theme/assets/' ~ css) | fingerprint }}">
  {% endfor %}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap">

  <!-- Favicon -->
  <link rel="shortcut icon" href="/theme/assets/favicon-16x16.png" type="image/png">
  <link rel="icon" type="image/png" sizes="32x32" href="/theme/assets/favicon-32.png">
  <link rel="apple-touch-icon" href="/theme/assets/apple-touch-icon.png">

  {% if page.json_ld %}{{ page.json_ld | safe }}{% endif %}

  {# Original ms-viewport fix for IE Mobile 10, kept verbatim (needs the
     nonce: it is an inline script under the CSP). #}
  <script nonce="{{ nonce }}">
    // Copyright 2014-2017 The Bootstrap Authors
    // Copyright 2014-2017 Twitter, Inc.
    // Licensed under MIT (https://github.com/twbs/bootstrap/blob/master/LICENSE)
    if (navigator.userAgent.match(/IEMobile\/10\.0/)) {
      var msViewportStyle = document.createElement('style')
      msViewportStyle.appendChild(
        document.createTextNode(
          '@-ms-viewport{width:auto!important}'
        )
      )
      document.head.appendChild(msViewportStyle)
    }
  </script>
</head>

<body {% block body_attrs %}class="site"{% endblock %}>

  <div class="site-wrap">

    <header class="site-header ">
      <div class="">
        <div class="measure">

          <!-- Navigation (Bootstrap 5 markup; same look as the old
               navbar-inverse bar) -->
          <nav class="navbar navbar-expand-md navbar-dark bg-dark">
            <div class="container-fluid">

            <a class="navbar-brand" href="/">
              <img src="/theme/assets/img/praxkit-logo-rund.png" width="70" height="70" alt="">
            </a>

            <span class="navbar-text d-none d-md-inline"> Die genial einfache Praxis App.</span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav mx-auto w-100 justify-content-center">
                <li class="nav-item{% if page.url == '/' %} active{% endif %}">
                  <a class="nav-link" href="/#top">Home{% if page.url == '/' %} <span class="sr-only">(current)</span>{% endif %}</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/#praxis">Praxis</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/#werte">Werte</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/#features">Funktionen</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/preise">Kosten</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/#news">News</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link scroll" href="/#kontakt">Kontakt</a>
                </li>
              </ul>
              <ul class="nav navbar-nav ml-auto w-100 justify-content-end">
                <li class="nav-item">
                  <a class="btn align-middle btn-outline-success scroll" href="/#kontakt">Anmelden</a>
                </li>
              </ul>
            </div>
            </div>
          </nav>

          <div class="clearfix"></div>
        </div>
      </div>
    </header>

    {% block main %}{% endblock %}

    <!-- Footer -->
    <div class="container-fluid footer">
      <div class="row">

        <div class="col-sm-12">

          <a class="footer-logo" href="/#top">
            <img class="card-img-left" src="/theme/assets/img/praxkit-logo.png" width="100" height="100" alt="praxkit-logo">
          </a>
          <div id="address">
            <address>
              PraxKit<br> by Kapp Technology GmbH<br> Schützengasse 38c<br> CH 2502 Biel/Bienne<br> hallo at praxkit.ch
            </address>
          </div>
        </div>

      </div>
      <div id="footernotes" class="row">
        <div class="col-sm-12">

          <ul class="list-unstyled list-inline">
            <li>
              <a href="/blog"><i class="fa-solid fa-bullhorn"></i>&nbsp;&nbsp;News</a>
            </li>
            <li>
              <a href="https://x.com/praxkit" target="_blank"><i class="fa-brands fa-x-twitter"></i>&nbsp;&nbsp;X</a>
            </li>
            <li> <a href="/" title="Privacy Policy">Privacy Policy</a> </li>
            <li> <a href="/" title="Terms of Use">Terms of Use</a> </li>
            <li>
              <a href="https://www.kapp.technology" target="_blank"> © {{ now().year }}  Kapp Technology GmbH, all rights reserved.</a>
            </li>
            <li>Erstellt mit <a href="https://accentcms.dev">Accent CMS</a> {{ accent.version_string }}</li>
            <li>Vielen Dank für deinen Besuch. Bis bald! &#8212; Aktualisierung: {{ now() | date("%d.%m.%Y") }}</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Scripts: Bootstrap 5 bundle (Popper included, no jQuery). The old
         stack (jQuery 1.12, Tether, Bootstrap 4 alpha, contact.js) is gone;
         the contact form posts natively to Formspree. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" nonce="{{ nonce }}"></script>

    <!-- To collapse the nav on the mobile view after a click -->
    <script nonce="{{ nonce }}">
      document.querySelectorAll('#navbarSupportedContent a').forEach(function (link) {
        link.addEventListener('click', function () {
          var nav = document.getElementById('navbarSupportedContent');
          if (nav.classList.contains('show')) {
            bootstrap.Collapse.getOrCreateInstance(nav).hide();
          }
        });
      });
    </script>

    {% block scripts %}{% endblock %}
  </div> <!-- site-wrap -->
</body>

</html>
